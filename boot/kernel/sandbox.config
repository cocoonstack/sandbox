# sandbox guest kernel fragment, applied over `x86_64_defconfig` +
# `kvm_guest.config` (see boot/Dockerfile). Everything the boot path touches
# is built in (=y): no modules to load, no initramfs modprobe, no udev settle.
# Rationale: cocoon-specs/design/sandbox-fast-boot.md.

## No module support at all — the strongest "nothing to wait for" guarantee.
# CONFIG_MODULES is not set

## EXPERT unlocks the hidden-prompt disables below (VT is "bool ... if EXPERT"
## and forced =y otherwise).
CONFIG_EXPERT=y

## Boot entry: PVH lets Cloud Hypervisor boot vmlinux without decompression.
CONFIG_PVH=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_PRINTK_TIME=y

## Virtio PCI transport and devices.
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_VIRTIO_PCI=y
# CONFIG_VIRTIO_MMIO is not set
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_FUSE_FS=y
CONFIG_VIRTIO_FS=y

## Rootfs: EROFS layers (cocoon converts with -zlz4hc) + overlay + ext4 COW.
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_OVERLAY_FS=y
CONFIG_OVERLAY_FS_REDIRECT_DIR=y
CONFIG_OVERLAY_FS_INDEX=y
CONFIG_OVERLAY_FS_METACOPY=y
CONFIG_OVERLAY_FS_XINO_AUTO=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_AUTOFS_FS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y
# Entropy: since 6.2 the kernel trusts CPU/bootloader seeds by default
# (random.trust_cpu removed as a Kconfig) — no boot-time entropy stall.

## Console: virtio-console hvc0.
## No VT/VGA, no PS/2 — kills the i8042 probe the old cmdline worked around.
## INPUT_KEYBOARD must go too: KEYBOARD_ATKBD (default y) selects SERIO_I8042.
# CONFIG_SERIAL_8250 is not set
CONFIG_UNIX98_PTYS=y
# CONFIG_VT is not set
# CONFIG_LEGACY_PTYS is not set
# CONFIG_INPUT_KEYBOARD is not set
# CONFIG_INPUT_MOUSE is not set
# CONFIG_SERIO is not set

## ACPI power button → cocoon's graceful shutdown; PCI hotplug for extend.
CONFIG_ACPI=y
CONFIG_ACPI_BUTTON=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_HOTPLUG_PCI=y
CONFIG_HOTPLUG_PCI_ACPI=y

## Containers inside the sandbox (docker/podman): namespaces, cgroup2,
## seccomp, bridge/veth + netfilter NAT. Software-only features — they add
## kernel size, not boot time.
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_BPF=y
CONFIG_POSIX_MQUEUE=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_KEYS=y
CONFIG_BRIDGE=y
CONFIG_VETH=y
CONFIG_TUN=y
CONFIG_NETFILTER=y
# NETFILTER_ADVANCED gates BRIDGE_NETFILTER and most xt matches on 6.18.
CONFIG_NETFILTER_ADVANCED=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_COMPAT=y
CONFIG_NFT_CT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REJECT=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
# Legacy iptables (alpine and older images inside sandboxes still ship it);
# gated behind NETFILTER_XTABLES_LEGACY + per-family *_LEGACY on 6.18.
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_IP6_NF_IPTABLES_LEGACY=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_NAT=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y

## Net basics.
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y

## Timers / memory.
CONFIG_HZ_1000=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_IDLE=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y

## Measured cuts (initcall_debug on a real boot, 2026-07-03): NFS+SUNRPC,
## guest-pointless IOMMU drivers, jitterentropy self-init, quota, netlabel,
## kprobes, and RTC (kvmclock supplies wall time via KVM_GUEST).
# CONFIG_NFS_FS is not set
# CONFIG_AMD_IOMMU is not set
# CONFIG_INTEL_IOMMU is not set
# In-kernel IPsec pulls the GENIV->DRBG->jitterentropy chain whose self-init
# costs ~9ms/boot; userspace VPNs don't need it. Kernel ESP/AH is therefore
# unavailable inside sandboxes.
# CONFIG_INET_ESP is not set
# CONFIG_INET_AH is not set
# CONFIG_INET_IPCOMP is not set
# CONFIG_INET6_ESP is not set
# CONFIG_INET6_AH is not set
# CONFIG_INET6_IPCOMP is not set
# CONFIG_CRYPTO_JITTERENTROPY is not set
# CONFIG_QUOTA is not set
# CONFIG_NETLABEL is not set
# CONFIG_KPROBES is not set
# CONFIG_RTC_CLASS is not set
## Trim: no sound/USB/graphics/vendor hardware, no debug info, no ftrace.
## Guest disks are virtio-blk only; guest NICs are virtio-net only.
# CONFIG_SOUND is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_HID_SUPPORT is not set
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_AGP is not set
# CONFIG_SCSI is not set
# CONFIG_ATA is not set
# CONFIG_MD is not set
# CONFIG_BLK_DEV_NVME is not set
# CONFIG_ETHERNET is not set
# CONFIG_WLAN is not set
# CONFIG_WIRELESS is not set
# CONFIG_RFKILL is not set
# HWMON is dragged in =y by x86 thermal plumbing; framework-only (no sensor
# drivers enabled), zero probe cost — accepted like CPU_FREQ below.
# CONFIG_WATCHDOG is not set
# CONFIG_I2C is not set
# CPU_FREQ is selected by X86 itself (arch/x86/Kconfig) and cannot be
# disabled; harmless in a VM — no cpufreq driver ever binds.
# CONFIG_NUMA is not set
# CONFIG_KEXEC is not set
# CONFIG_FTRACE is not set
CONFIG_DEBUG_INFO_NONE=y
# Boot-time W+X page-table scan: debug-only cost on every boot (it also
# flagged 6 W+X pages on the PVH path — tracked separately).
# CONFIG_DEBUG_WX is not set
